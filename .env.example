# ==============================================================
# PayPal ResolveAI — Environment Configuration Template
# Copy this file to .env or backend/.env (Never commit real keys!)
# ==============================================================

# Client Environment (Vite)
VITE_APP_ENV=development

# --------------------------------------------------------------
# 1. Hosted AI Model Configuration (Server-Side Only)
# Get a free Gemini API key from https://aistudio.google.com/
# --------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_PROVIDER=gemini
AI_MODEL_NAME=gemini-2.5-flash

# (Optional Alternative Provider: OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# --------------------------------------------------------------
# 2. PayPal Developer Sandbox Configuration (Server-Side Only)
# Get credentials from https://developer.paypal.com/dashboard/applications/sandbox
# --------------------------------------------------------------
# PAYPAL_CLIENT_ID=your_sandbox_client_id_here
# PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Database
DATABASE_URL=sqlite:///./resolveai.db
