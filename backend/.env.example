# ==============================================================
# PayPal ResolveAI Backend — Environment Configuration Template
# Copy this file to backend/.env (Never commit real keys!)
# ==============================================================

# Server-Side Google Gemini AI
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_PROVIDER=gemini
AI_MODEL_NAME=gemini-flash-lite-latest

# PayPal Developer Sandbox (Server-Side Only)
# Get credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Database persistence (SQLite)
DATABASE_URL=sqlite:///./resolveai.db
